{
  "name": "engineering-analysis-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Engineering analysis and data processing desktop application",
  "author": "Engineering Analysis Suite",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 0.0.0.0",
    "dev:electron": "wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .",
    "build": "vite build",
    "electron": "electron .",
    "dist": "electron-builder --win portable --config.win.signAndEditExecutable=false",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.0",
    "electron": "^31.7.0",
    "electron-builder": "^25.1.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.10",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.engineering.analysis.suite",
    "productName": "Engineering Analysis Suite",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "EngineeringAnalysisSuite-${version}.exe",
      "signAndEditExecutable": false
    }
  }
}
